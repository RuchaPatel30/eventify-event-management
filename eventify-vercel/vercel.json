{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.php" },
    { "source": "/index.php", "destination": "/api/index.php" },
    { "source": "/book.php", "destination": "/api/book.php" },
    { "source": "/confirmation.php", "destination": "/api/confirmation.php" },
    { "source": "/my_bookings.php", "destination": "/api/my_bookings.php" }
  ]
}
